// ============================================================
// Kyuzen C++ SDK — libc++ site configuration (Phase 6)
//
// Pengganti `__config_site` hasil CMake (yang tidak pernah dijalankan
// untuk target ini). Diletakkan di sdk/cpp/include/ sehingga
// `#include <__config_site>` dari <__config> menyelesaikannya TANPA
// menyentuh tree LLVM. Nilai = baremetal KyuzenOS: tanpa thread, tanpa
// locale/filesystem/terminal/clock, ABI Itanium v1, hardening NONE
// (verbose_abort tetap tersedia untuk jalur no-exceptions yang jujur;
// lihat audit §18).
//
// Sinkron dengan: libcxx/include/__config_site.in (22.1.8). Bila upgrade
// LLVM, bandingkan ulang file ini dengan .in yang baru.
// ============================================================
#ifndef _LIBCPP___CONFIG_SITE
#define _LIBCPP___CONFIG_SITE

#define _LIBCPP_ABI_VERSION 1
// WAJIB (bukan opsional): namespace ABI inline untuk v1 adalah __1
// (cmake: LIBCXX_ABI_NAMESPACE default "__${VERSION}"). Tanpanya menjadi
// `inline namespace {anonymous}` yang bertabrakan dengan using-declaration
// libc++ sendiri (mis. std::remove vs using ::remove — ditemukan saat audit).
#define _LIBCPP_ABI_NAMESPACE __1
#define _LIBCPP_ABI_FORCE_ITANIUM 0
#define _LIBCPP_ABI_FORCE_MICROSOFT 0
#define _LIBCPP_HAS_THREADS 0
#define _LIBCPP_HAS_MONOTONIC_CLOCK 0
#define _LIBCPP_HAS_TERMINAL 0
#define _LIBCPP_HAS_MUSL_LIBC 0
#define _LIBCPP_HAS_THREAD_API_PTHREAD 0
#define _LIBCPP_HAS_THREAD_API_EXTERNAL 0
#define _LIBCPP_HAS_THREAD_API_WIN32 0
#define _LIBCPP_HAS_THREAD_API_C11 0 // FIXME: Is this guarding dead code?
#define _LIBCPP_DISABLE_VISIBILITY_ANNOTATIONS
#define _LIBCPP_HAS_VENDOR_AVAILABILITY_ANNOTATIONS 0
// _LIBCPP_TYPEINFO_COMPARISON_IMPLEMENTATION sengaja TIDAK didefinisikan:
// <typeinfo> mendeteksi otomatis bila tak didefinisikan (Itanium → 1).
// Mendefinisikannya 0 = "invalid configuration" (ditemukan saat audit).
#define _LIBCPP_HAS_FILESYSTEM 0
#define _LIBCPP_HAS_RANDOM_DEVICE 0
#define _LIBCPP_HAS_LOCALIZATION 0
#define _LIBCPP_HAS_UNICODE 0
#define _LIBCPP_HAS_WIDE_CHARACTERS 0
#define _LIBCPP_HAS_TIME_ZONE_DATABASE 0
#define _LIBCPP_INSTRUMENTED_WITH_ASAN 0

// Hardening NONE + assertion QUICK_ENFORCE (trap seketika, tanpa OS dep).
// Lihat __assertion_handler (adaptasi vendor default, tanpa cabang C++03).
#define _LIBCPP_HARDENING_MODE_DEFAULT _LIBCPP_HARDENING_MODE_NONE
#define _LIBCPP_ASSERTION_SEMANTIC_DEFAULT _LIBCPP_ASSERTION_SEMANTIC_QUICK_ENFORCE

#define _LIBCPP_LIBC_PICOLIBC 0
#define _LIBCPP_LIBC_NEWLIB 0

// PSTL backend SERIAL (default cmake non-Apple): algoritma paralel
// dieksekusi sekuensial — tanpa thread, tanpa dispatch. Tanpa satu pun
// backend terdefinisi, <algorithm> gagal dengan "Invalid PSTL backend
// configuration" (ditemukan saat audit).
#define _LIBCPP_PSTL_BACKEND_SERIAL 1

#endif // _LIBCPP___CONFIG_SITE
