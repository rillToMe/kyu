# Runtime artifacts from `make run` (QEMU serial mirror / test dumps)
serial.log
# Runtime log di root repo (mis. f_settings.log dari app Settings).
# Sengaja di-scope ke root (/*.log) supaya log dokumentasi yang memang
# disimpan di docs/troubleshooting/ tidak ikut tersembunyi.
/*.log

# Output probe GUI host-side (PPM ~24 MB) — regenerated oleh
# `make probe-*` / tests/host/probes/_ui_probe.py
tests/host/probes/_ui_out/
tests/host/probes/__pycache__/

# Host tool binary (dibangun oleh `make mkfs` dari tools/mkfs.kyuzenfs.c)
/mkfs.kyuzenfs

# Build directories.
#
# Everything CMake generates lives under build/ — the target build in
# build/target/, the host tests in build/host/, and the generated compiler
# wrappers in build/tools/. Nothing is written into the source tree, so
# `rm -rf build` is a complete reset.
#
# The stale patterns below (build-cmake/, build-*/) are kept only so that a
# build directory left over from the Make -> CMake migration does not suddenly
# show up as untracked. They can go once those directories are gone.
build/
bin/
out/
build-cmake/
build-*/
/graphify-out
.codegraph

# The C++ SDK compiler wrapper is SOURCE, not a build output. It lives in a
# bin/ directory (matching where the SDK stages it) but is a tracked input:
# libs/cpp/CMakeLists.txt copies it into the SDK and depends on it, so
# without it a fresh clone fails to build. The negation must follow the bin/
# pattern above to win.
!/libs/cpp/bin/
!/libs/cpp/bin/kyuzen-c++

# llvm-project: ~1.9 GB, deliberately not committed. Fetch it with
# ./build.sh setup, which clones it sparsely (about 137 MB) at the pinned tag.
#
# The old pattern was "stdlib/llvm-project" with no leading path, so it never
# actually matched this directory — the clone only stayed out of git because a
# gitlink for it happened to be in the index. Anchored properly now.
/third_party/stdlib/llvm-project/

# Kyuzen-specific LLVM libc configuration. Tracked on purpose: upstream ships
# no x86_64 baremetal variant, so these are ours, and they used to live inside
# the gitignored clone where a re-clone would have destroyed them.
# NOT ignored:
!/third_party/stdlib/kyuzen/

