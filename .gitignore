# Runtime artifacts from `make run` (QEMU serial mirror / test dumps)
serial.log
# Runtime log di root repo (mis. f_settings.log dari app Settings).
# Sengaja di-scope ke root (/*.log) supaya log dokumentasi yang memang
# disimpan di docs/troubleshooting/ tidak ikut tersembunyi.
/*.log

# Output probe GUI host-side (PPM ~24 MB) — regenerated oleh
# `make probe-*` / tests/host/probes/_ui_probe.py
tests/host/probes/_ui_out/
tests/host/probes/__pycache__/

# Host tool binary (dibangun oleh `make mkfs` dari tools/mkfs.kyuzenfs.c)
/mkfs.kyuzenfs

# Build directories.
#
# Everything CMake generates lives under build/ — the target build in
# build/target/, the host tests in build/host/, and the generated compiler
# wrappers in build/tools/. Nothing is written into the source tree, so
# `rm -rf build` is a complete reset.
#
# The stale patterns below (build-cmake/, build-*/) are kept only so that a
# build directory left over from the Make -> CMake migration does not suddenly
# show up as untracked. They can go once those directories are gone.
build/
bin/
out/
build-cmake/
build-*/
/graphify-out
.codegraph

stdlib/llvm-project

