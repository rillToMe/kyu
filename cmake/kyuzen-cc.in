#!/usr/bin/env sh
# ============================================================================
# kyuzen-cc — compiler wrapper that normalises depfile paths for native Ninja.
#
#   kyuzen-cc <real-compiler> <args...>
#
# WHY THIS EXISTS
#   MSYS2's usr/bin clang is a Cygwin binary: it reports include paths in POSIX
#   form in its -MF depfile.
#
#       /usr/lib/clang/21/include/stdint.h
#       /usr/include/stdint.h
#
#   Ninja is a NATIVE Windows binary and cannot resolve /usr/... — it looks for
#   <build-dir>/usr/... and does not find it, so it treats every such dependency
#   as MISSING. A missing input keeps the target permanently out of date, and
#   the affected objects rebuild on every single invocation.
#
#   The failure is badly misleading from the build output:
#     - a no-op `ninja` reports hundreds of rebuilds;
#     - `ninja -d explain` blames "stdint.h is dirty" although the file is
#       untouched and older than the object it supposedly invalidates;
#     - `ninja -n` (dry run) reports nothing to do at all.
#
# WHAT IT DOES
#   Runs the real compiler unchanged, then rewrites the -MF depfile in place,
#   mapping the POSIX prefixes to their real Windows locations.
#
# WHY NOT USE THE clang64 (MINGW) CLANG INSTEAD
#   It emits native paths, but it is LLVM 22 while the parity baseline was
#   produced with LLVM 21 — and it generates a byte-different kernel. The whole
#   point of this migration is that the build system changes while the output
#   does not, so clang 21 stays and the depfile is fixed instead.
#
# The wrapper is generated by cmake/KyuzenCompiler.cmake; this file is the
# template and documents the contract.
# ============================================================================
set -eu

if [ $# -lt 2 ]; then
    echo "kyuzen-cc: usage: kyuzen-cc <compiler> <args...>" >&2
    exit 2
fi

REAL_COMPILER="$1"
shift

# Remember the depfile argument (if any) before running the compiler.
DEPFILE=""
prev=""
for arg in "$@"; do
    if [ "$prev" = "-MF" ]; then
        DEPFILE="$arg"
        prev=""
        continue
    fi
    case "$arg" in
        -MF)   prev="-MF" ;;
        -MF*)  DEPFILE="${arg#-MF}" ;;
    esac
done

# Run the real compiler. Under `set -e` a non-zero exit propagates verbatim,
# so no explicit status check is needed here — the rewrite below must never
# run on a failed compile (a partial depfile is not worth normalising).
"$REAL_COMPILER" "$@"

# Rewrite POSIX prefixes so native Ninja can stat every dependency.
#
# Ninja hands us -MF as a NATIVE WINDOWS path carrying literal backslashes:
#
#     -MF libs\gui\widget\CMakeFiles\...\theme.cpp.obj.d
#
# sh passes that argv element through verbatim, so `[ -f "$DEPFILE" ]` probes
# for a file literally named "libs\gui\...d", fails, and silently skips the
# whole rewrite. (clang, being a Cygwin binary, reads the backslash as a path
# separator and writes the depfile to the normal location — only sh disagrees.)
# Normalise to forward slashes before touching the file.
DEPFILE_NORM=$(printf '%s' "$DEPFILE" | tr '\\' '/')

if [ -n "$DEPFILE_NORM" ] && [ -f "$DEPFILE_NORM" ]; then
    # Only pay for sed when a POSIX prefix is actually present. grep scans the
    # whole file (a head -c heuristic would miss /usr/ paths in the tail of a
    # large depfile) and exits on the first match.
    if grep -qE '(^|[[:space:]])/usr/' "$DEPFILE_NORM"; then
        # Delimiter is '#' — it must NOT be '|', because the regex itself uses
        # '|' for alternation and sed would read that as the end of the s///
        # expression ("unknown option to `s'").
        #
        # The (^|[[:space:]]) guard anchors the match to a whole path
        # component, so an already-native path such as
        # E:/Tools/msys2/usr/lib/clang/... is left alone (its "/usr/" is
        # preceded by '2', not by whitespace).
        #
        # There is deliberately no rule for bare /lib/: no depfile in this tree
        # contains it, and mapping it to <root>/lib would point at a directory
        # that does not exist (MSYS2 exposes /lib as a symlink to usr/lib).
        sed -E -e "s#(^|[[:space:]])/usr/#\1@MSYS_ROOT@/usr/#g" \
            "$DEPFILE_NORM" > "$DEPFILE_NORM.tmp" &&
            mv "$DEPFILE_NORM.tmp" "$DEPFILE_NORM"
    fi
fi
